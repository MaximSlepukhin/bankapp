{
  "name": "POST convert USD → CNY (rate: 7.5)",
  "request": {
    "method": "POST",
    "url": "/api/v1/exchange/convert",
    "bodyPatterns": [
      {"matchesJsonPath": {"expression": "$.from", "equalTo": "USD"}},
      {"matchesJsonPath": {"expression": "$.to",   "equalTo": "CNY"}}
    ]
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json"},
    "body": "{\"original\": {{jsonPath request.body '$.amount'}}, \"from\": \"USD\", \"to\": \"CNY\", \"converted\": {{math (jsonPath request.body '$.amount') '*' 7.5}}}",
    "transformers": ["response-template"]
  }
}
